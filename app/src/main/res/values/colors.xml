<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launcher_bg">#2E7D32</color>
    <!-- Widget colours: explicit day/night values (values-night overrides) so text
         always contrasts with the background, whatever theme the launcher uses. -->
    <color name="widget_bg">@android:color/system_neutral1_50</color>
    <color name="text_primary">@android:color/system_neutral1_900</color>
    <color name="text_secondary">@android:color/system_neutral2_700</color>
    <color name="status_ok">#2E7D32</color>
    <color name="status_late">#E65100</color>
    <color name="status_cancelled">#C62828</color>
</resources>
